{
  "name": "underwater",
  "version": "1.0.0",
  "private": true,
  "description": "深蓝 · ABYSS —— 单文件、零素材的程序化海底生存游戏",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:min": "node tools/build.mjs --minify",
